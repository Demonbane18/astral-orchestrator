+def parse_expectation(value: str) -> tuple[str, str]:
+    lane, separator, effort = value.partition("=")
+    if not separator or not lane or not effort:
+        raise argparse.ArgumentTypeError(
+            "expectations must use lane=value"
+        )
+    if lane not in LANES:
+        raise argparse.ArgumentTypeError(
+            f"unknown effort lane {lane!r}; choose from {', '.join(LANES)}"
+        )
+    if effort not in ALLOWED_EFFORTS:
+        raise argparse.ArgumentTypeError(
+            f"unsupported effort for {lane}: {effort}; choose from "
+            + ", ".join(ALLOWED_EFFORTS)
+        )
+    return lane, effort
+
+
 def parse_args() -> argparse.Namespace:
     parser = argparse.ArgumentParser(
         description="Show or change Astral Orchestrator effort levels."
@@ -54,6 +72,19 @@ def parse_args() -> argparse.Namespace:
         action="store_true",
