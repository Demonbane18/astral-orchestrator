+def print_check_result(
+    efforts: dict[str, str],
+    expected: dict[str, str],
+    settings_path: Path,
+    *,
+    file_present: bool,
+) -> bool:
+    mismatches = {
+        lane: {"actual": efforts[lane], "expected": expected_effort}
+        for lane, expected_effort in expected.items()
+        if efforts[lane] != expected_effort
+    }
+    matched = not mismatches
+    print(
+        json.dumps(
+            {
+                "changed": False,
+                "effort": efforts,
+                "expected": expected,
+                "matched": matched,
+                "mismatches": mismatches,
+                "settings_file": str(settings_path),
+                "settings_file_present": file_present,
+            },
+            separators=(",", ":"),
+            sort_keys=True,
+        )
+    )
+    return matched
+
+
 def main() -> int:
