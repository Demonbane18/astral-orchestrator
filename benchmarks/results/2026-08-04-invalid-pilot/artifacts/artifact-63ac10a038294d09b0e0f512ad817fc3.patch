+def print_check_result(
+    efforts: dict[str, str],
+    expectations: dict[str, str],
+    settings_path: Path,
+    *,
+    file_present: bool,
+    as_json: bool,
+) -> bool:
+    mismatches = {
+        lane: {"actual": efforts[lane], "expected": expected}
+        for lane, expected in expectations.items()
+        if efforts[lane] != expected
+    }
+    matched = not mismatches
+    if as_json:
+        print(
+            json.dumps(
+                {
+                    "changed": False,
+                    "effort": efforts,
+                    "expected": expectations,
+                    "matched": matched,
+                    "mismatches": mismatches,
+                    "settings_file": str(settings_path),
+                    "settings_file_present": file_present,
+                },
+                separators=(",", ":"),
+                sort_keys=True,
+            )
+        )
+        return matched
+
+    print(f"Effort expectation check {'passed' if matched else 'failed'}.")
+    for lane, expected in expectations.items():
+        actual = efforts[lane]
+        status = "matched" if actual == expected else f"expected {expected}"
+        print(f"  {lane.capitalize()}: {actual} ({status})")
+    print(f"Settings file: {settings_path}")
+    return matched
+
