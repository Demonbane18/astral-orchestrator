+def parse_expectations(values: list[str]) -> dict[str, str]:
+    expectations: dict[str, str] = {}
+    for value in values:
+        lane, separator, effort = value.partition("=")
+        if not separator or not lane or not effort or "=" in effort:
+            fail(f"invalid expectation {value!r}; use lane=value")
+        if lane not in LANES:
+            fail(
+                f"unknown expectation lane {lane!r}; choose from "
+                + ", ".join(LANES)
+            )
+        if effort not in ALLOWED_EFFORTS:
+            fail(
+                f"unsupported expected effort for {lane}: {effort}; choose from "
+                + ", ".join(ALLOWED_EFFORTS)
+            )
+        if lane in expectations and expectations[lane] != effort:
+            fail(f"conflicting expectations for {lane}")
+        expectations[lane] = effort
+    return expectations
+
