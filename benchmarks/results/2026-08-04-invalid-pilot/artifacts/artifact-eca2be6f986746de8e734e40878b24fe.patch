+def parse_expectations(raw_expectations: list[str]) -> dict[str, str]:
+    """Validate --expect values and return them indexed by lane."""
+    expectations: dict[str, str] = {}
+    for raw_expectation in raw_expectations:
+        lane, separator, effort = raw_expectation.partition("=")
+        if separator != "=" or not lane or not effort or "=" in effort:
+            fail("--expect must use LANE=EFFORT")
+        if lane not in LANES:
+            fail(f"unknown effort lane: {lane}; choose from " + ", ".join(LANES))
+        if effort not in ALLOWED_EFFORTS:
+            fail(
+                f"unsupported effort for {lane}: {effort}; choose from "
+                + ", ".join(ALLOWED_EFFORTS)
+            )
+        if lane in expectations:
+            fail(f"--expect may only be supplied once for {lane}")
+        expectations[lane] = effort
+    return expectations
+
