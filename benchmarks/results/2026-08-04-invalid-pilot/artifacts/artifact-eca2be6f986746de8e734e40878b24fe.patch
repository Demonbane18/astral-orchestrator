+def print_check_result(
+    efforts: dict[str, str],
+    expectations: dict[str, str],
+    settings_path: Path,
+    *,
+    file_present: bool,
+) -> bool:
+    """Print a read-only expectation report and return whether it matched."""
+    mismatches = [
+        {
+            "actual": efforts[lane],
+            "expected": expected,
+            "lane": lane,
+        }
+        for lane, expected in expectations.items()
+        if efforts[lane] != expected
+    ]
+    matched = not mismatches
+    print(
+        json.dumps(
+            {
+                "changed": False,
+                "effort": efforts,
+                "expected": expectations,
+                "matched": matched,
+                "mismatches": mismatches,
+                "settings_file": str(settings_path),
+                "settings_file_present": file_present,
+            },
+            separators=(",", ":"),
+            sort_keys=True,
+        )
+    )
+    return matched
+
