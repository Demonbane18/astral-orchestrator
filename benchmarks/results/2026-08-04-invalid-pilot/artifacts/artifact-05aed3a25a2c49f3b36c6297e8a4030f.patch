+def parse_expectations(raw_expectations: list[str]) -> dict[str, str]:
+    """Validate --expect values and return them in stable lane order."""
+    expectations: dict[str, str] = {}
+    for raw_expectation in raw_expectations:
+        lane, separator, effort = raw_expectation.partition("=")
+        if not separator or not lane or not effort:
+            fail(f"invalid expectation: {raw_expectation!r}; use LANE=EFFORT")
+        if lane not in LANES:
+            fail(
+                f"unknown expectation lane: {lane}; choose from "
+                + ", ".join(LANES)
+            )
+        if effort not in ALLOWED_EFFORTS:
+            fail(
+                f"unsupported expectation for {lane}: {effort}; choose from "
+                + ", ".join(ALLOWED_EFFORTS)
+            )
+        if lane in expectations:
+            fail(f"duplicate expectation for {lane}")
+        expectations[lane] = effort
+    return {lane: expectations[lane] for lane in LANES if lane in expectations}
+
