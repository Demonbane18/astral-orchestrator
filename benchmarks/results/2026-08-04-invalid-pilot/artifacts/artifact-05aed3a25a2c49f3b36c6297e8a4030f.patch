+def print_check_result(
+    efforts: dict[str, str],
+    expectations: dict[str, str],
+    settings_path: Path,
+    *,
+    file_present: bool,
+) -> bool:
+    """Print a deterministic JSON report for a read-only expectation check."""
+    mismatches = [
+        {
+            "actual": efforts[lane],
+            "expected": expected_effort,
+            "lane": lane,
+        }
+        for lane, expected_effort in expectations.items()
+        if efforts[lane] != expected_effort
+    ]
+    matched = not mismatches
+    print(
+        json.dumps(
+            {
+                "changed": False,
+                "effort": efforts,
+                "expectations": expectations,
+                "matched": matched,
+                "mismatches": mismatches,
+                "settings_file": str(settings_path),
+                "settings_file_present": file_present,
+            },
+            separators=(",", ":"),
+            sort_keys=True,
+        )
+    )
+    return matched
+
