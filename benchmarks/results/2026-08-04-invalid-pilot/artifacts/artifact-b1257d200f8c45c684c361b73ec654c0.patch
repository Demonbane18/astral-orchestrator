@@ -29,6 +29,24 @@ def fail(message: str) -> NoReturn:
     raise SystemExit(1)
 
 
+def parse_expectation(value: str) -> tuple[str, str]:
+    lane, separator, effort = value.partition("=")
+    if not separator or not lane or not effort:
+        raise argparse.ArgumentTypeError(
+            "expectation must use lane=value, such as luna=xhigh"
+        )
+    if lane not in LANES:
+        raise argparse.ArgumentTypeError(
+            f"unknown effort lane {lane!r}; choose from {', '.join(LANES)}"
+        )
+    if effort not in ALLOWED_EFFORTS:
+        raise argparse.ArgumentTypeError(
+            f"unsupported effort for {lane}: {effort}; choose from "
+            + ", ".join(ALLOWED_EFFORTS)
+        )
+    return lane, effort
+
+
 def parse_args() -> argparse.Namespace:
     parser = argparse.ArgumentParser(
         description="Show or change Astral Orchestrator effort levels."
@@ -49,6 +67,19 @@ def parse_args() -> argparse.Namespace:
         action="store_true",
         help="Restore all four effort levels to Astral Orchestrator defaults.",
     )
+    parser.add_argument(
+        "--check",
+        action="store_true",
+        help="Check read-only expectations against the effective settings.",
+    )
+    parser.add_argument(
+        "--expect",
+        action="append",
+        default=[],
+        type=parse_expectation,
+        metavar="LANE=VALUE",
+        help="Expected lane effort for --check; repeat for additional lanes.",
+    )
     parser.add_argument(
         "--json",
         action="store_true",
@@ -96,6 +127,48 @@ def print_result(
         print("Note: max and ultra are model- and account-dependent.")
 
 
+def print_check_result(
+    efforts: dict[str, str],
+    expected: dict[str, str],
+    settings_path: Path,
+    *,
+    file_present: bool,
+    as_json: bool,
+) -> bool:
+    mismatches = {
+        lane: {"actual": efforts[lane], "expected": effort}
+        for lane, effort in expected.items()
+        if efforts[lane] != effort
+    }
+    matched = not mismatches
+    if as_json:
+        print(
+            json.dumps(
+                {
+                    "changed": False,
+                    "effort": efforts,
+                    "expected": expected,
+                    "matched": matched,
+                    "mismatches": mismatches,
+                    "settings_file": str(settings_path),
+                    "settings_file_present": file_present,
+                },
+                separators=(",", ":"),
+                sort_keys=True,
+            )
+        )
+    elif matched:
+        print("CHECK PASSED: all requested effort expectations match.")
+    else:
+        print("CHECK FAILED: requested effort expectations do not match.")
+        for lane, mismatch in mismatches.items():
+            print(
+                f"  {lane}: expected {mismatch['expected']}, "
+                f"found {mismatch['actual']}"
+            )
+    return matched
+
+
 def main() -> int:
